<Window x:Class="memoria_játék.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:memoria_játék"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="24" Width="255"><Run Language="hu-hu" Text="Kérem adja meg mekkora legyen a pálya:"/></TextBlock>
        <ListBox x:Name="lbox_meret" Margin="400,10,27,324" SelectionChanged="Kivalasztasmeret"/>
        <ListBox x:Name="lbox_type" Margin="10,10,397,324" SelectionChanged="Kivalasztas2"/>
        <TextBlock x:Name="tb_kiirat" TextWrapping="Wrap" Width="120" Margin="408,399,272,11" RenderTransformOrigin="0.477,0.822" />
        <TextBlock x:Name="tb_kiirat2" TextWrapping="Wrap" Width="120" Margin="598,400,82,10" RenderTransformOrigin="0.477,0.822" />

        <Grid Margin="50,130,52,55">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="btn_grid" SnapsToDevicePixels="True"/>
        </Grid>
        <Button x:Name="starter" Content="indit" HorizontalAlignment="Center" Margin="0,379,0,0" VerticalAlignment="Top" Width="50" Click="starter_Click" RenderTransformOrigin="0.578,0.634"/>
    </Grid>
</Window>
